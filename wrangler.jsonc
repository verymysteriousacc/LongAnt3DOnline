{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "longant3donline",
  "main": "worker.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/room/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
